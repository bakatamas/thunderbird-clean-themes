{
  "manifest_version": 2,
  "name": "Clean Auto",
  "description": "Fewer borders, two surfaces and one accent colour. Follows the system light or dark setting.",
  "version": "1.1.6",
  "author": "Tamás Baka",
  "browser_specific_settings": {
    "gecko": {
      "id": "clean-auto@tamasbaka.clean-themes",
      "strict_min_version": "153.0",
      "update_url": "https://celest-watches.com/clean-themes/updates.json"
    }
  },
  "theme": {
    "properties": {
      "color_scheme": "system",
      "content_color_scheme": "system"
    }
  },
  "theme_experiment": {
    "stylesheet": "theme.css"
  }
}